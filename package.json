{
  "name": "tws-panel",
  "version": "0.1.0",
  "private": true,
  "description": "TWS Panel — painel PaaS self-hosted open-source: transforma uma VPS Ubuntu em plataforma de hospedagem pessoal.",
  "author": "Kelvin — CEO & Founder @ TWS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @paas/server run dev",
    "dev:web": "pnpm --filter @paas/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "start": "pnpm --filter @paas/server run start",
    "test:mail": "tsx scripts/test-mail.mts",
    "test:fase4": "tsx scripts/test-fase4.mts",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r --if-present run test",
    "test:e2e": "pnpm run test:fase4 && pnpm run test:mail",
    "test:coverage": "pnpm -r --if-present run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "imapflow": "^1.0.164",
    "nodemailer": "^9.0.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  }
}

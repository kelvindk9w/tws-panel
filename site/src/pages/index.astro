---
// Site root: send visitors to the documentation in their language.
// English is the default; Portuguese (Brazil) is picked from the browser language.
// Add more languages by extending the `startsWith` check below and the
// `locales` list in astro.config.mjs.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fallback = `${base}/en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TWS Panel documentation</title>
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <link rel="canonical" href={fallback} />
    <script is:inline define:vars={{ base }}>
      var lang = (navigator.language || 'en').toLowerCase();
      var target = lang.indexOf('pt') === 0 ? 'pt-br' : 'en';
      location.replace(base + '/' + target + '/');
    </script>
  </head>
  <body>
    <p><a href={fallback}>TWS Panel documentation</a></p>
  </body>
</html>
